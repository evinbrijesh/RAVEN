# RAVEN environment configuration — copy to .env and adjust.
# Never commit real keys. All fixture data must remain synthetic.

# --- Control plane (apps/api) ---
RAVEN_ENV=development
RAVEN_API_HOST=0.0.0.0
RAVEN_API_PORT=8000
# SQLite for the hackathon profile; switch to postgresql+asyncpg:// for production.
RAVEN_DATABASE_URL=sqlite:///./data/raven.db
# Optional: enables the Redis-backed queue instead of the in-process queue.
RAVEN_REDIS_URL=
RAVEN_CORS_ORIGINS=http://localhost:3000

# --- Worker (workers/evaluator) ---
RAVEN_WORKER_CONCURRENCY=2
RAVEN_SCAN_TIMEOUT_SECONDS=600
RAVEN_MODEL_CALL_TIMEOUT_SECONDS=30
RAVEN_MAX_ATTACK_CASES=12
RAVEN_MAX_ATTEMPTS_PER_ATTACK=2
RAVEN_MAX_MODEL_CALLS=40
RAVEN_MAX_TOTAL_TOKENS=200000

# --- Model plane (provider adapter; leave empty to run deterministic-only) ---
RAVEN_MODEL_PROVIDER=none
RAVEN_MODEL_NAME=
RAVEN_MODEL_API_KEY=
RAVEN_MODEL_BASE_URL=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
