# RAVEN unified backend (FastAPI control plane + Evaluation Worker in one container).
# Ideal for single-container cloud hosting (Railway, Render, Fly.io, GCP Cloud Run)
# where both services share a persistent volume mounted at /data.
#
# Build context is the REPO ROOT:
#   docker build -f infra/Dockerfile.backend -t raven-backend .

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# 1. Copy workspace manifests first for layer caching
COPY pyproject.toml ./pyproject.toml
COPY README.md ./README.md
COPY apps/api/pyproject.toml ./apps/api/pyproject.toml
COPY workers/evaluator/pyproject.toml ./workers/evaluator/pyproject.toml
COPY workers/evaluator/README.md ./workers/evaluator/README.md
COPY packages/raven-guard/pyproject.toml ./packages/raven-guard/pyproject.toml
COPY packages/raven-guard/README.md ./packages/raven-guard/README.md

# 2. Pre-fetch third-party dependencies for all workspace members
RUN uv sync --all-packages --no-install-workspace --no-dev

# 3. Copy application source code, attack catalog, and fixtures
COPY apps/api/app ./apps/api/app
COPY apps/api/migrations ./apps/api/migrations
COPY workers/evaluator/evaluator ./workers/evaluator/evaluator
COPY packages/raven-guard/raven_guard ./packages/raven-guard/raven_guard
COPY packages/attack-catalog ./packages/attack-catalog
COPY fixtures ./fixtures
COPY infra/start-backend.sh /app/start-backend.sh

# 4. Install all workspace packages in editable mode
RUN uv sync --all-packages --no-dev

# 5. Make startup script executable and set PATH
RUN chmod +x /app/start-backend.sh
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH="/app/apps/api:/app/workers/evaluator:/app/packages/raven-guard:${PYTHONPATH:-}"

# Create non-root system user and configure persistent data volume permissions
RUN groupadd -r raven && useradd -r -g raven -d /app -s /sbin/nologin raven && \
    mkdir -p /data && chown -R raven:raven /data /app

USER raven

# Default port
EXPOSE 8000

# Volume target for persistent SQLite and evidence
VOLUME ["/data"]

CMD ["/app/start-backend.sh"]
