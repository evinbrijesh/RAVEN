# RAVEN control plane (FastAPI).
# Build context is the REPO ROOT so the uv workspace resolves:
#   docker build -f infra/Dockerfile.api .
#
# Runtime contract:
#   - SQLite/evidence live on a mounted volume (compose mounts raven-data at /data).
#   - Listens on 0.0.0.0:8000 (RAVEN_API_PORT is honored by compose-provided env).
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Workspace metadata first (root + members) so dependency layers cache.
# uv.lock is gitignored, so builds resolve fresh; switch to `--frozen` if a
# lockfile is ever committed.
COPY pyproject.toml ./pyproject.toml
COPY README.md ./README.md
COPY apps/api/pyproject.toml ./apps/api/pyproject.toml
COPY workers/evaluator/pyproject.toml ./workers/evaluator/pyproject.toml
COPY workers/evaluator/README.md ./workers/evaluator/README.md
COPY packages/raven-guard/pyproject.toml ./packages/raven-guard/pyproject.toml
COPY packages/raven-guard/README.md ./packages/raven-guard/README.md

# Third-party dependencies only (workspace members not installed yet).
RUN uv sync --directory apps/api --no-install-workspace --no-dev

# Application source.
COPY apps/api/app ./apps/api/app
COPY apps/api/migrations ./apps/api/migrations

# Install the workspace member itself (editable).
RUN uv sync --directory apps/api --no-dev

ENV PATH="/app/.venv/bin:${PATH}"
WORKDIR /app/apps/api

# Create non-root system user and configure persistent data volume permissions
RUN groupadd -r raven && useradd -r -g raven -d /app -s /sbin/nologin raven && \
    mkdir -p /data && chown -R raven:raven /data /app

USER raven

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
