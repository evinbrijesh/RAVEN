# RAVEN web frontend (Next.js).
# Build context is the REPO ROOT:
#   docker build -f infra/Dockerfile.web .
#
# Prerequisites (satisfied once apps/web is implemented):
#   - apps/web/package.json (+ lockfile) with a `build` script
#   - next.config.* sets `output: "standalone"` (required by the runner stage)
FROM node:22-alpine AS deps
WORKDIR /app
COPY apps/web/package.json ./package.json
COPY apps/web/package-lock.json* ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web ./
# Guard so the runner-stage `COPY public` succeeds even before assets exist.
RUN mkdir -p public
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S raven && adduser -S raven -G raven

COPY --from=builder /app/public ./public
COPY --from=builder --chown=raven:raven /app/.next/standalone ./
COPY --from=builder --chown=raven:raven /app/.next/static ./.next/static

USER raven
EXPOSE 3000
CMD ["node", "server.js"]
